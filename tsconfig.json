{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-audit/types/**/*.ts",
    ".next-audit/dev/types/**/*.ts",
    ".next-audit2/types/**/*.ts",
    ".next-audit2/dev/types/**/*.ts",
    ".next-fix/types/**/*.ts",
    ".next-fix/dev/types/**/*.ts",
    ".next-img/types/**/*.ts",
    ".next-img/dev/types/**/*.ts",
    ".next-media/types/**/*.ts",
    ".next-media/dev/types/**/*.ts",
    ".next-csv/types/**/*.ts",
    ".next-csv/dev/types/**/*.ts",
    ".next-rand/types/**/*.ts",
    ".next-rand/dev/types/**/*.ts",
    ".next-td2/types/**/*.ts",
    ".next-td2/dev/types/**/*.ts",
    ".next-rand2/types/**/*.ts",
    ".next-rand2/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "Claude outputs"
  ]
}
